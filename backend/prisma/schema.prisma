generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Roles {
  id       Int    @unique
  roleName String
  User     User[]
}

model User {
  username      String @unique
  password      String
  role_id       Int
  department_Id Int
  city          String
  role          Roles  @relation(fields: [role_id], references: [id])
}


